# ============================================================
# SafeClaw Environment Variables
# Copy to .env and fill in real values
# ============================================================

# --- Django Core ---
DJANGO_SECRET_KEY=your-very-long-random-secret-key-here
DJANGO_DEBUG=false
ALLOWED_HOSTS=safeclaw.ru,www.safeclaw.ru,localhost,127.0.0.1

# --- Database ---
# PostgreSQL (production):
DATABASE_URL=postgresql://safeclaw:YOUR_DB_PASSWORD@db:5432/safeclaw
# Omit DATABASE_URL to use SQLite locally

# --- CORS ---
CORS_ALLOWED_ORIGINS=https://safeclaw.ru,https://www.safeclaw.ru

# --- ЮKassa (Billing) ---
YOOKASSA_SHOP_ID=your_shop_id
YOOKASSA_SECRET_KEY=your_secret_key
YOOKASSA_RETURN_URL=https://safeclaw.ru/billing/payment/success/

# --- LLM Providers ---
DEEPSEEK_API_KEY=sk-...
GIGACHAT_API_KEY=your_gigachat_bearer_token
YANDEXGPT_API_KEY=your_yandex_api_key
YANDEXGPT_FOLDER_ID=your_yandex_folder_id

# --- Self-hosted providers (OpenAI-compatible) ---
# Leave defaults for local dev, update for production
TPRO_API_KEY=none
TPRO_BASE_URL=http://localhost:8001/v1

QWEN_API_KEY=none
QWEN_BASE_URL=http://localhost:8002/v1

LLAMA_API_KEY=none
LLAMA_BASE_URL=http://localhost:11434/v1
